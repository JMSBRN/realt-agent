# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому бот отвечает: Telegram user id через запятую (узнать у @userinfobot). Пусто — всем.
ALLOWED_TELEGRAM_IDS=

# Курс для пересчёта цен, если клиент назвал сумму в белорусских рублях
USD_BYN_RATE=3.0

# WebSocket для расширения. Тот же токен вводится в настройках расширения.
WS_HOST=127.0.0.1
WS_PORT=8765
WS_TOKEN=change-me-to-a-long-random-string

# Карта результатов («🗺 Показать на карте»). PUBLIC_URL — адрес, по которому сервер виден из интернета:
# http://IP:8080 откроется в браузере, https://домен — прямо внутри Telegram. Пусто — без карты.
PUBLIC_URL=
MAP_HOST=0.0.0.0
MAP_PORT=8080

# Лиды в Google Sheets (см. README → «Google Sheets»): путь к JSON-ключу сервисного аккаунта
# и ссылка на таблицу (или её id). GOOGLE_SHEET_TAB — название листа, пусто — первый лист.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET=
GOOGLE_SHEET_TAB=
# Telegram id риелторов через запятую — им приходит уведомление о каждом новом лиде
REALTOR_CHAT_IDS=

# Собеседник: отвечает на вопросы «сколько однушек в Гомеле?», «какие новостройки в Минске?».
# Любая модель с OpenAI-совместимым API; по умолчанию — Groq (ключ: console.groq.com → API Keys).
# Пусто — бот работает только по кнопкам и правилам, как раньше.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Как часто проверять подписки «следить за новыми», минут
WATCH_INTERVAL_MIN=30
DB_PATH=realt-agent.db
