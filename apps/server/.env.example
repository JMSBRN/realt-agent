# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому бот отвечает: Telegram user id через запятую (узнать у @userinfobot). Пусто — всем.
ALLOWED_TELEGRAM_IDS=

# Курс для пересчёта цен, если клиент назвал сумму в белорусских рублях
USD_BYN_RATE=3.0

# WebSocket для расширения. Тот же токен вводится в настройках расширения.
WS_HOST=127.0.0.1
WS_PORT=8765
WS_TOKEN=change-me-to-a-long-random-string

# Как часто проверять подписки «следить за новыми», минут
WATCH_INTERVAL_MIN=30
DB_PATH=realt-agent.db
